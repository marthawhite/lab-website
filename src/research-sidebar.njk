---
layout: layouts/page.njk
title: Research
permalink: /research-sidebar/
---
{% from "partials/selected-pubs.njk" import selectedPublications %}
{% set researchView = "sidebar" %}
{% include "partials/research-top.njk" %}

<section class="section research-sidebar-layout">
  <nav class="research-toc" aria-label="Research topics">
    <p class="research-toc__label">Topics</p>
    <ul>
      {% for topic in research %}
        <li><a href="#{{ topic.id }}">{{ topic.title }}</a></li>
      {% endfor %}
    </ul>
  </nav>
  <div class="research-sidebar-main">
    {% for topic in research %}
      <article class="research-topic research-topic--sidebar" id="{{ topic.id }}">
        <h2 class="research-topic__title">{{ topic.title }}</h2>
        <div class="research-topic__body">{{ topic.body | markdown | safe }}</div>
        {{ selectedPublications(publications | resolvePublications(topic.publications)) }}
      </article>
    {% endfor %}
  </div>
</section>
