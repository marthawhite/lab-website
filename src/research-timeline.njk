---
layout: layouts/page.njk
title: Research
permalink: /research-timeline/
---
{% from "partials/selected-pubs.njk" import selectedPublications %}
{% set researchView = "timeline" %}
{% include "partials/research-top.njk" %}

<section class="section research-timeline">
  {% for topic in research %}
    <article class="research-tl">
      <div class="research-tl__marker" aria-hidden="true"></div>
      <div class="research-tl__body">
        <h2 class="research-topic__title">{{ topic.title }}</h2>
        <div class="research-topic__body">{{ topic.body | markdown | safe }}</div>
        {{ selectedPublications(publications | resolvePublications(topic.publications)) }}
      </div>
    </article>
  {% endfor %}
</section>
