---
layout: layouts/page.njk
title: Research
permalink: /research-banner/
---
{% from "partials/selected-pubs.njk" import selectedPublications %}
{% set researchView = "banner" %}
{% include "partials/research-top.njk" %}

<section class="section research-banner">
  {% for topic in research %}
    <article class="research-bnr">
      <div class="research-bnr__media">
        <img src="{{ topic.image | withBaseUrl }}" alt="">
        <h2 class="research-bnr__title">{{ topic.title }}</h2>
      </div>
      <div class="research-topic__body">{{ topic.body | markdown | safe }}</div>
      {{ selectedPublications(publications | resolvePublications(topic.publications)) }}
    </article>
  {% endfor %}
</section>
