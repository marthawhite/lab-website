---
layout: layouts/page.njk
title: Talks
lede: Recorded talks and presentations by members of the lab.
permalink: /talks/
---
{% set sortedTalks = talks | sortTalks %}

<header class="page-header">
  <h1 class="page-header__title">{{ title }}</h1>
  {% if lede %}<p class="page-header__intro">{{ lede }}</p>{% endif %}
</header>

<section class="section talks-page">
  <div class="talks-table-wrap">
    <table class="talks-table">
      <thead>
        <tr>
          <th scope="col" class="talks-table__col-thumb"><span class="sr-only">Preview</span></th>
          <th scope="col" class="talks-table__col-talk">Talk</th>
          <th scope="col" class="talks-table__col-speaker">Speaker</th>
          <th scope="col" class="talks-table__col-year">Year</th>
          <th scope="col" class="talks-table__col-slides">Slides</th>
        </tr>
      </thead>
      <tbody>
        {% for talk in sortedTalks | withTalkMedia %}
          {% set src = talk.embed | embedUrl %}
          {% set thumb = talk.thumbnail or (talk.embed | embedThumb) %}
          {% set memberSite = members | memberWebsite(talk.speaker) %}
          {% set speakerSite = memberSite if memberSite else ("/" if talk.speaker == site.facultyName else "") %}
          <tr>
            <td class="talks-table__col-thumb">
              {% if talk.embed %}
                <button
                  type="button"
                  class="talk-row-thumb"
                  data-talk-embed="{{ src }}"
                  data-talk-title="{{ talk.title }}"
                  aria-label="Play: {{ talk.title }}"
                >
                  {% if thumb %}
                    <img class="talk-row-thumb__img" src="{{ thumb | withBaseUrl }}" alt="" loading="lazy">
                  {% else %}
                    <span class="talk-row-thumb__img talk-row-thumb__img--blank"></span>
                  {% endif %}
                  <span class="talk-row-thumb__play" aria-hidden="true">&#9654;</span>
                </button>
              {% elif talk.slides %}
                <a
                  class="talk-row-thumb talk-row-thumb--pdf"
                  href="{{ talk.slides | withBaseUrl }}"
                  target="_blank"
                  rel="noopener"
                  aria-label="View slides: {{ talk.title }}"
                >
                  {% if thumb %}
                    <img class="talk-row-thumb__img" src="{{ thumb | withBaseUrl }}" alt="" loading="lazy">
                  {% else %}
                    <span class="talk-row-thumb__img talk-row-thumb__img--blank"></span>
                  {% endif %}
                  <span class="talk-row-thumb__play talk-row-thumb__play--pdf" aria-hidden="true">PDF</span>
                </a>
              {% endif %}
            </td>
            <td class="talks-table__col-talk">
              <p class="talk-entry__title">{{ talk.title }}</p>
              {%- if talk.event or talk.location %}
                <p class="talk-entry__venue">
                  {%- if talk.event %}{{ talk.event }}{% endif -%}
                  {%- if talk.location %}{% if talk.event %}, {% endif %}{{ talk.location }}{% endif -%}
                </p>
              {%- endif -%}
              {%- if talk.type %}<p class="talk-card__kicker">{{ talk.type }}</p>{% endif -%}
            </td>
            <td class="talks-table__col-speaker">
              {%- if speakerSite %}<a href="{{ speakerSite | withBaseUrl }}">{{ talk.speaker }}</a>{% else %}{{ talk.speaker }}{% endif -%}
            </td>
            <td class="talks-table__col-year">{{ talk.year if talk.year else "" }}</td>
            <td class="talks-table__col-slides">
              {%- if talk.slides %}<a href="{{ talk.slides | withBaseUrl }}" target="_blank" rel="noopener">PDF</a>{% endif -%}
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="5" class="meta">No recorded talks yet.</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>

<dialog class="video-dialog" id="talk-dialog" aria-label="Talk video">
  <div class="video-dialog__inner">
    <button type="button" class="video-dialog__close" data-dialog-close aria-label="Close video">&times;</button>
    <div class="talk-embed">
      <iframe
        id="talk-dialog-frame"
        title="Talk video"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</dialog>

<script>
  (() => {
    const dialog = document.getElementById("talk-dialog");
    const frame = document.getElementById("talk-dialog-frame");
    if (!dialog || !frame || typeof dialog.showModal !== "function") return;

    document.querySelectorAll("[data-talk-embed]").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const src = trigger.getAttribute("data-talk-embed");
        frame.src = src.includes("?") ? `${src}&autoplay=1` : `${src}?autoplay=1`;
        dialog.showModal();
      });
    });

    const close = () => dialog.close();
    dialog.querySelectorAll("[data-dialog-close]").forEach((b) => b.addEventListener("click", close));

    dialog.addEventListener("click", (event) => {
      const rect = dialog.getBoundingClientRect();
      const inside =
        event.clientX >= rect.left &&
        event.clientX <= rect.right &&
        event.clientY >= rect.top &&
        event.clientY <= rect.bottom;
      if (!inside) close();
    });

    // Stop playback when the dialog closes
    dialog.addEventListener("close", () => {
      frame.src = "";
    });
  })();
</script>
